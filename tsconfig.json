{
    "version" : "3.0.3",
    "compilerOptions" : {
        "module" : "esnext",  /*  ES6 modules */
        "target" : "esnext",
        "outDir" : "./dist",  /*  Output directory */
        "rootDir" : "./",
        "removeComments" : true,
        "baseUrl" : "./",
        "sourceMap" : true,  /*  only to debug ts files */
        "alwaysStrict" : true,
        "declaration" : true,
        "declarationMap" : true,
        "allowJs" : false,
        "lib": [
          "es2015",
          "DOM"
        ]
        
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "./dist",
        "./node_modules",
        "./00"
    ]
}
